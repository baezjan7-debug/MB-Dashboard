rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /clients/{doc} {
      allow read, write: if true;
    }
    match /invoices/{invoiceId} {
      allow read, write: if true;
      match /comments/{commentId} {
        allow read, write: if true;
      }
    }
    match /users/{userId} {
      allow read, write: if true;
      match /sessions/{sessionId} {
        allow read, write: if true;
      }
    }
    match /notifications/{doc} {
      allow read, write: if true;
    }
    match /meta/{doc} {
      allow read, write: if true;
    }
  }
}
